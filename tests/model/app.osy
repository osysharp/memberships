// Everything the pool says to the kits: its roles and its answers to their policies, its settings, a locker of its own
// handed out when somebody is let in, and what it does when the kit tells it something.

using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.PrepaidCredits;
using Osysharp.Memberships;

[Role] enum PoolRole { Authenticator, Swimmer, Cashier, Lifeguard }

policy IsCashier => RoleGrant.Any(g => g.Member == user && g.Role == PoolRole.Cashier);
policy IsLifeguard => RoleGrant.Any(g => g.Member == user && g.Role == PoolRole.Lifeguard);
policy IsSwimmer => RoleGrant.Any(g => g.Member == user && g.Role == PoolRole.Swimmer);

/// The cashier sells and looks after memberships; the lifeguard lets people in.
policy SellsMemberships => IsCashier;
policy AdmitsMembers => IsLifeguard;

/// The desk reads the visits left on a card through Osysharp.PrepaidCredits' own rules.
policy ManagesCredits => IsCashier;
policy SpendsCredits => IsLifeguard;

/// A parent acts for the child they made an account for — for memberships and for the visits on them.
policy ActsForMember(Principal holder) =>
  holder == user || ManagedAccountRequest.Any(r => r.Account == holder && r.Guardian == user);
policy ActsForCreditHolder(Principal holder) =>
  holder == user || ManagedAccountRequest.Any(r => r.Account == holder && r.Guardian == user);

/// A swimmer may make an account for a child they bring.
policy MakesManagedAccounts => IsSwimmer;

app.Accounts = new AccountsSetup { AppName = "Northside Pool", SignupRole = PoolRole.Swimmer };
app.Memberships = new MembershipsSetup { NoticeDays = 10, MembersMayPause = true, MembersCheckIn = true };

/// A locker key, handed out with every swim — the pool's own record, not the kit's.
entity LockerLoan {
  [Required] Principal Swimmer;
  [MaxLength(20)] string Locker = "";
  DateTime At = DateTime.UtcNow;
  security { allow read when IsLifeguard || IsCashier; }
}

/// Who swam today gets a locker.
[On] void HandOutALocker(MemberAdmitted e) { new LockerLoan { Swimmer = e.Admission.Person, Locker = "L" + (LockerLoan.Count() + 1) }; }

/// What the pool's handlers heard from the kit, one row per event — a stand-in for the mail it would send.
entity Heard {
  [MaxLength(40)] string Event = "";
  [MaxLength(200)] string Detail = "";
  security { allow read when IsAuthenticated; }
}

[On] void HearSold(MembershipSold e) { new Heard { Event = "sold", Detail = e.Membership.Plan.Name }; }
[On] void HearRefused(AdmissionRefused e) { new Heard { Event = "refused", Detail = e.Admission.Reason }; }
[On] void HearPaused(MembershipPaused e) { new Heard { Event = "paused", Detail = e.Membership.Plan.Name }; }
[On] void HearResumed(MembershipResumed e) { new Heard { Event = "resumed", Detail = e.Membership.Plan.Name + ":" + e.Days }; }
[On] void HearEndingSoon(MembershipEndingSoon e) { new Heard { Event = "endingsoon", Detail = e.Membership.Plan.Name }; }
[On] void HearEnded(MembershipEnded e) { new Heard { Event = "ended", Detail = e.Membership.Plan.Name + ":" + e.Membership.EndedBecause }; }
[On] void HearTransferred(MembershipTransferred e) { new Heard { Event = "transferred", Detail = e.To.Holder.DisplayName }; }
[On] void HearRenewed(MembershipRenewed e) { new Heard { Event = "renewed", Detail = e.Next.Plan.Name }; }

/// The pool's own price list, built from the kit's: choosing a plan would start the pool's checkout; here it says so.
[Route("/")] [AllowAnonymous] [Render(CSR)] [Title("Join the pool")]
component JoinPage() {
  string chosen = "";
  action Choose(MembershipPlan p) { chosen = p.Name; }
  render {
    Stack(gap: 5, p: 6) {
      PageHead("Swim with us", subtitle: "Every way in, and what it costs.");
      MembershipPlanList(Choose, choose: "Buy");
      if (chosen != "") { Alert("Next: paying for " + chosen + ".", tone: Tone.Success); }
    }
  }
}

/// The pool renews a family year by itself: it would charge the kept card here (Osysharp.Payments), then renew.
[On] void RenewWhenDue(MembershipRenewalDue e) {
  new Heard { Event = "renewaldue", Detail = e.Membership.Plan.Name };
  RenewMembership(e.Membership);
}
