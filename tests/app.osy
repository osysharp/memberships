// The producer's test project for Osysharp.Memberships — a public swimming pool: day tickets, a monthly membership that
// can be paused, a card of ten swims that starts on the first swim, and a family year for four. The cashier sells, the
// lifeguard at the gate lets people in, swimmers check themselves in at the turnstile, and a parent swims with a child
// who never signs in (a managed account of Osysharp.UserAccounts).
app MembershipsKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  use Osysharp.EmailTemplates@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.PrepaidCredits@0;
  use Osysharp.Memberships@0;
  use Osysharp.Ui;
  use Osysharp.Workflow;
}
